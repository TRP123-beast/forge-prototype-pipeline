# Forge Prototype Pipeline — environment template.
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Required. Your Anthropic API key. Get one at https://console.anthropic.com.
# The pipeline will fail immediately at startup if this is missing or invalid.
ANTHROPIC_API_KEY=sk-ant-...

# Default model used for prototype generation. Opus is the highest-quality model
# and the right choice when you care about output quality. Override to a cheaper
# model (e.g. claude-sonnet-4-6) when you're iterating on prompts and want fast
# feedback at lower cost.
ANTHROPIC_MODEL_PRIMARY=claude-opus-4-7

# Faster, cheaper model used for lightweight calls (mock data, self-checks,
# anything where Sonnet quality is sufficient).
ANTHROPIC_MODEL_FAST=claude-sonnet-4-6

# Optional. A Vercel deployment token. Leave blank to use the credentials from
# `vercel login` on this machine — that's the recommended setup for local dev.
# Set this only in CI or non-interactive environments.
VERCEL_TOKEN=

# Logger verbosity. One of: debug | info | warn | error. Default is `info`.
# Use `debug` when investigating a failed generation — it prints the full
# prompt rendering and SDK request/response metadata.
LOG_LEVEL=info
